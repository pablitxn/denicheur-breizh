# syntax=docker/dockerfile:1@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32

FROM node:26.10.0-bookworm-slim@sha256:662933cf47f013bc8e4beb31a6116448427a82057ba7c42c97e4c5ba766504c2 AS dependencies

ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}

WORKDIR /workspace

RUN npm install --global pnpm@12.7.0 \
  && pnpm config set store-dir /pnpm/store \
  && pnpm config set fetch-timeout 600000 \
  && pnpm config set fetch-retries 5 \
  && pnpm config set network-concurrency 4 \
  && pnpm config set child-concurrency 1

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/collector-api/package.json ./apps/collector-api/package.json
COPY apps/collector-web/package.json ./apps/collector-web/package.json
COPY apps/extension/package.json ./apps/extension/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY packages/collector-contracts/package.json ./packages/collector-contracts/package.json
COPY packages/design-system/package.json ./packages/design-system/package.json
COPY packages/i18n/package.json ./packages/i18n/package.json

# Do not disable lifecycle scripts here: pnpm-workspace.yaml explicitly allows
# Sharp, and its native package must be present in the final Linux image.
ARG PNPM_LOCKFILE_PREVERIFIED=false
RUN pnpm install --frozen-lockfile \
  --config.trust-lockfile=${PNPM_LOCKFILE_PREVERIFIED} \
  --filter @denicheur-breizh/api... \
  --os=linux \
  --cpu=x64 \
  --libc=glibc

# Keep pnpm 12 pre-run verification aligned with the installation target.
ENV pnpm_config_supported_architectures='{"os":["linux"],"cpu":["x64"],"libc":["glibc"]}'

FROM dependencies AS build

COPY . .

RUN pnpm --filter @denicheur-breizh/api... run build
# The one-shot config keeps deployment isolated to this image while making
# pnpm derive a portable, lockfile-backed tree for the workspace package.
RUN pnpm --filter @denicheur-breizh/api \
  --config.inject-workspace-packages=true \
  deploy --prod /opt/denicheur-api

# Verify the exact portable tree copied into the runtime stage. This fails the
# build on a non-Linux/x64 runner, a missing native binding, or absent WebP
# support instead of discovering the mismatch after deployment.
RUN cd /opt/denicheur-api \
  && node --input-type=module -e \
    "import sharp from 'sharp'; if (process.platform !== 'linux' || process.arch !== 'x64') throw new Error('API image must be built for linux/x64'); const output = await sharp({ create: { width: 1, height: 1, channels: 3, background: '#ffffff' } }).webp().toBuffer(); if (output.subarray(8, 12).toString() !== 'WEBP') throw new Error('Sharp WebP output is unavailable'); console.log('verified sharp ' + sharp.versions.sharp + ' on ' + process.platform + '/' + process.arch);"

FROM node:26.10.0-bookworm-slim@sha256:662933cf47f013bc8e4beb31a6116448427a82057ba7c42c97e4c5ba766504c2 AS production

ARG OCI_REVISION=dev
LABEL org.opencontainers.image.title="denicheur-breizh-api" \
  org.opencontainers.image.revision=${OCI_REVISION}

ENV NODE_ENV=production \
  FILTER_API_HOST=0.0.0.0 \
  FILTER_API_PORT=4310 \
  DENICHEUR_DB_PATH=/data/denicheur.sqlite

WORKDIR /app

COPY --from=build --chown=node:node /opt/denicheur-api/ ./
RUN mkdir -p /data \
  && chown node:node /data \
  && chmod 0700 /data

USER node

EXPOSE 4310

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:4310/health').then((response) => { if (!response.ok) throw new Error('unhealthy') })"]

CMD ["node", "dist/server.js"]
