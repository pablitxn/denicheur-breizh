{
  "name": "@denicheur-breizh/collector-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "cli": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@denicheur-breizh/collector-contracts": "workspace:*",
    "express": "^5.2.1",
    "cors": "^2.8.6",
    "helmet": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/cors": "^2.8.19",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.2"
  }
}
