{
  "name": "@denicheur-breizh/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt -b chrome",
    "build": "wxt build -b chrome",
    "zip": "wxt zip -b chrome",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include 'src/**/*.ts' --coverage.include 'src/**/*.tsx' --coverage.reporter text-summary --coverage.reportsDirectory ../../coverage/extension",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@denicheur-breizh/contracts": "workspace:*",
    "@denicheur-breizh/design-system": "workspace:*",
    "@denicheur-breizh/i18n": "workspace:*",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wxt": "^0.21.4",
    "web-ext": "^10.7.0"
  }
}
