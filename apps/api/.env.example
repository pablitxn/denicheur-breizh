# Development is local and may run without credentials. Production startup is
# fail-closed and requires operator/media settings plus pricing when OpenAI is enabled.
NODE_ENV=development
# Production must set this assertion explicitly to 1. Multiple API replicas are
# unsupported while media delivery concurrency and byte budgets remain process-local.
API_REPLICA_COUNT=1
# Production must place this file on persistent storage so rolling provider
# reservations and all collected state survive a container/process restart.
DENICHEUR_DB_PATH=.data/denicheur.sqlite
OPENAI_API_KEY=
# Required in production. Generate a high-entropy value and keep it only in the
# API secret plus the operator's local extension storage; never bake it into JS.
OPERATOR_TOKEN=
OPENAI_FILTER_MODEL=gpt-5-mini-2025-08-07
# Integer micro-USD per one million tokens. Keep zero when OpenAI is disabled in
# development. Production with OPENAI_API_KEY refuses to start until both current
# provider prices are configured explicitly; this repository does not guess them.
OPENAI_INPUT_PRICE_MICRO_USD_PER_MILLION_TOKENS=0
OPENAI_OUTPUT_PRICE_MICRO_USD_PER_MILLION_TOKENS=0
# Repository-backed rolling budget for every Responses API call, including
# durable, compatibility, and run-evaluation routes. Reservations survive API
# restarts. Production remains restricted to one API replica.
OPENAI_GLOBAL_BUDGET_WINDOW_MS=60000
OPENAI_GLOBAL_MAX_PROVIDER_CALLS=200
OPENAI_GLOBAL_MAX_INPUT_TOKENS=1000000
OPENAI_GLOBAL_MAX_OUTPUT_TOKENS=1000000
OPENAI_GLOBAL_MAX_COST_MICRO_USD=3000000
# Realtime sessions cannot be fully metered by this API. They are disabled by
# default and production refuses to start if this is enabled.
OPENAI_REALTIME_ENABLED=false
# Server ceilings for one durable evaluation execution. A request may ask for
# lower limits, but cannot raise these values. 1 USD equals 1,000,000 micro-USD.
EVALUATION_MAX_PROVIDER_CALLS=200
EVALUATION_MAX_INPUT_TOKENS=1000000
EVALUATION_MAX_OUTPUT_TOKENS=1000000
EVALUATION_MAX_COST_MICRO_USD=3000000
FILTER_API_PORT=4310
# Keep loopback for local development. Container deployments must explicitly
# bind on all interfaces and restrict access at the ingress/network-policy layer.
FILTER_API_HOST=127.0.0.1
# Media mirroring is optional in development. Set the mode to minio and start
# compose.media.yml to download Leboncoin CDN images into the private local bucket.
MEDIA_STORAGE_MODE=disabled
MEDIA_S3_ENDPOINT=http://127.0.0.1:9000
MEDIA_S3_BUCKET=denicheur-breizh-media
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ACCESS_KEY_ID=denicheur-local-media
MEDIA_S3_SECRET_ACCESS_KEY=denicheur-local-media-password
MEDIA_S3_FORCE_PATH_STYLE=true
# Admission limits are checked before new media jobs are written. Non-ready
# assets reserve bytes pessimistically until their actual object sizes are known.
MEDIA_MAX_ASSETS_PER_RUN=500
MEDIA_MAX_PENDING_JOBS=1000
MEDIA_MAX_RESERVED_BYTES=5368709120
MEDIA_RESERVED_BYTES_PER_ASSET=20971520
# Delivery limits use a 60-second window. Concurrency and bytes are process-wide;
# the request-rate limiter uses Express's client IP key.
MEDIA_DELIVERY_RATE_LIMIT_MAX=120
MEDIA_DELIVERY_MAX_CONCURRENT=8
MEDIA_DELIVERY_MAX_BYTES_PER_MINUTE=268435456
# Optional comma-separated exact allowlist. When unset, localhost pages and the
# repository's pinned Chrome extension origin are accepted.
# FILTER_API_ALLOWED_ORIGINS=http://127.0.0.1:5173,chrome-extension://oekklajlieiinmjcmhdfeodpdhahhjdi
