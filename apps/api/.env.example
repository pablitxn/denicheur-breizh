OPENAI_API_KEY=
# Required in production. Generate a high-entropy value and keep it only in the
# API secret plus the operator's local extension storage; never bake it into JS.
OPERATOR_TOKEN=
OPENAI_FILTER_MODEL=gpt-5-mini-2025-08-07
FILTER_API_PORT=4310
# Keep loopback for local development. Container deployments must explicitly
# bind on all interfaces and restrict access at the ingress/network-policy layer.
FILTER_API_HOST=127.0.0.1
DENICHEUR_DB_PATH=.data/denicheur.sqlite
# Media mirroring is optional in development. Set the mode to minio and start
# compose.media.yml to download Leboncoin CDN images into the private local bucket.
MEDIA_STORAGE_MODE=disabled
MEDIA_S3_ENDPOINT=http://127.0.0.1:9000
MEDIA_S3_BUCKET=denicheur-breizh-media
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ACCESS_KEY_ID=denicheur-local-media
MEDIA_S3_SECRET_ACCESS_KEY=denicheur-local-media-password
MEDIA_S3_FORCE_PATH_STYLE=true
# Optional comma-separated exact allowlist. When unset, localhost pages and the
# repository's pinned Chrome extension origin are accepted.
# FILTER_API_ALLOWED_ORIGINS=http://127.0.0.1:5173,chrome-extension://oekklajlieiinmjcmhdfeodpdhahhjdi
