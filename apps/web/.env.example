VITE_API_BASE_URL=http://127.0.0.1:4310
VITE_ENABLE_REALTIME=false
# Production images reject overrides of VITE_API_BASE_URL=/api. Runtime
# WEB_* gateway settings and secret-file paths belong to the container
# orchestrator, not this file. Production requires separate operator and
# trusted-ingress token files; see apps/web/README.md.
# WEB_API_UPSTREAM=http://api:4310
# WEB_OPERATOR_TOKEN_FILE=/run/secrets/denicheur-operator-token
# WEB_GATEWAY_AUTH_TOKEN_FILE=/run/secrets/denicheur-gateway-auth-token
# The VPN/SSO ingress must remove any client-supplied
# X-Denicheur-Ingress-Token and set it from the gateway secret. Only /healthz
# is public; never expose container port 8080 outside that trusted ingress.
